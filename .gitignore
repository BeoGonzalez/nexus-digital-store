# ==============================================================================
# Global .gitignore for Nexus Monorepo / Workspace
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets, Environment Variables & API Keys
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# Python & Virtual Environments (nexus-backend, nexus-ai, root)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
pyvenv.cfg
Lib/
Include/
Scripts/

# Packaging & Distribution
build/
dist/
*.egg-info/
.eggs/
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
zap-reports/

# Type Checking & Linters
.mypy_cache/
.pytype/
.ruff_cache/
.dmypy.json
dmypy.json

# Jupyter & Streamlit
.ipynb_checkpoints/
.streamlit/secrets.toml

# ------------------------------------------------------------------------------
# Node.js & Frontend (nexus-frontend)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js build output & artifacts
.next/
out/
tsconfig.tsbuildinfo
*.tsbuildinfo

# Vercel
.vercel/

# ------------------------------------------------------------------------------
# Vector Stores, AI Models & Local Databases
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
.chroma/
chroma/
*.bin
*.pt
*.pth
*.onnx
model_cache/
.huggingface/
.cache/

# ------------------------------------------------------------------------------
# IDEs & Editor Configuration
# ------------------------------------------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# VS Code (ignoring user-specific state, keeping shared tasks/launch if needed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ------------------------------------------------------------------------------
# Operating System & File System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

