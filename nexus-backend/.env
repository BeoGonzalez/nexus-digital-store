# ============================================
# Nexus Digital Store — Environment Variables
# ============================================

# Application
APP_NAME=Nexus Digital Store
DEBUG=false

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Groq LLM
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_NAME=openai/gpt-oss-120b

# LangSmith Observability
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=nexus-digital-store
LANGSMITH_TRACING=true

# Embeddings (local HuggingFace)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# RAG
VECTOR_SEARCH_TOP_K=5

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
