# ============================================
# Nexus Digital Store — Environment Variables
# ============================================

# Application
APP_NAME=Nexus Digital Store
DEBUG=false

# Database (PostgreSQL + Neon Serverless)
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_bpMd4xfoY8Aw@ep-winter-dust-aylq45fu-pooler.c-5.us-east-2.aws.neon.tech/neondb
NEON_POOLED=true
NEON_AUTH_URL=https://ep-winter-dust-aylq45fu.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Groq LLM (NexusBot)
GROQ_API_KEY=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
GROQ_MODEL_NAME=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.1

# Pinecone Vector Store
PINECONE_API_KEY=pcsk_3Zvmhw_28q1MZZ1PFTyrCNnV4f1G6Xnrz3D8WG7c44yUy2AKzG21829PjuwxYkYxzNC1Cu
PINECONE_INDEX_NAME=nexus-catalog
PINECONE_NAMESPACE=nexus_chile

# Wikipedia External Knowledge
WIKIPEDIA_LANG=es
WIKIPEDIA_TOP_K=1
WIKIPEDIA_MAX_CHARS=400

# Multi-Agent Orchestration (CrewAI + LangGraph)
ENABLE_CREWAI_ORCHESTRATION=true

# LangSmith Observability
LANGSMITH_API_KEY=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
LANGSMITH_PROJECT=nexus-digital-store
LANGSMITH_TRACING=true

# Embeddings (local HuggingFace)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# RAG
VECTOR_SEARCH_TOP_K=5

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
