# ============================================
# Nexus Digital Store — Environment Variables
# ============================================

# Application
APP_NAME=Nexus Digital Store
DEBUG=false

# Database (Amazon Aurora PostgreSQL / asyncpg)
# Local:   postgresql+asyncpg://postgres:postgres@localhost:5432/nexus
# Aurora:  postgresql+asyncpg://<username>:<password>@nexus-aurora-cluster.cluster-cnopkaetlofj.us-east-1.rds.amazonaws.com:5432/<dbname>
DATABASE_URL=ur-write
DATABASE_READ_URL=url-read
DB_SSL=false
RUN_DB_INIT=true

# AWS Cognito Identity
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq LLM
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_NAME=openai/gpt-oss-120b

# Pinecone Vector Store
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=nexus-games
PINECONE_NAMESPACE=catalog

# Wikipedia (Lore & Trivia)
WIKIPEDIA_LANG=es
WIKIPEDIA_TOP_K=1
WIKIPEDIA_MAX_CHARS=2000

# Tavily AI Search (Gaming News & Patches)
TAVILY_API_KEY=tvly-your-tavily-api-key
TAVILY_MAX_RESULTS=3

# CheapShark API (Price Comparison across Steam, Epic, GOG, etc.)
CHEAPSHARK_ENABLED=true
CHEAPSHARK_USD_CLP_RATE=950.0

# Laya AI & CrewAI Orchestration
LAYA_MODEL_NAME=groq/llama-3.1-8b-instant
ENABLE_CREWAI_ORCHESTRATION=false

# LangSmith Observability
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=nexus-digital-store
LANGSMITH_TRACING=true

# Embeddings (local HuggingFace)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# RAG
VECTOR_SEARCH_TOP_K=5
